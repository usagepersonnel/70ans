    {
      "id": "lw5GZCVV9HsHjppEojrf1",
      "type": "text",
      "x": -422.5145850499485,
      "y": 1993.3234659830425,
      "width": 1197.4444580078125,
      "height": 175,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0w",
