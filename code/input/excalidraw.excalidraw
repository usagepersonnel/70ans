      "seed": 1153881443,
      "version": 191,
      "versionNonce": 968143747,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1777820778087,
      "link": null,
      "locked": false,
      "text": "[Idée à valider] Plutôt que les rituels aient lieu tous les 100 ans (cf. l'idée\nde \"désactiver pour les 100 prochaines années\"), est-ce qu'on dirait pas 70\nans ou 140 ans ?",
      "fontSize": 20.404894977834495,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[Idée à valider] Plutôt que les rituels aient lieu tous les 100 ans (cf. l'idée de \"désactiver pour les 100 prochaines années\"), est-ce qu'on dirait pas 70 ans ou 140 ans ?",
      "autoResize": false,
      "lineHeight": 1.25
    },
